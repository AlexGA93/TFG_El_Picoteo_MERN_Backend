    {
      "id": "UD_fszjRRbMKPd-A0EnDY",
      "type": "text",
      "x": 2081.6345741284804,
      "y": -10812.520723965363,
      "width": 913,
      "height": 1725,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
