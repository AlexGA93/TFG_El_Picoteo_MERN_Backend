    {
      "id": "qOJzUz6NUFvwk9hwgW4AY",
      "type": "text",
      "x": -1448.2960996722022,
      "y": -10464.568136171887,
      "width": 924,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
