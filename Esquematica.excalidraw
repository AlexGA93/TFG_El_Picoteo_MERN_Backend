    {
      "id": "hVoTju7OG5dY4UIWOJyHA",
      "type": "text",
      "x": 2959.369493658765,
      "y": -8740.339822436552,
      "width": 946,
      "height": 1350,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2j",
      "roundness": null,
      "seed": 926200484,
      "version": 56,
      "versionNonce": 1656560164,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772942791819,
      "link": null,
      "locked": false,
      "text": "import { ResultSetHeader, RowDataPacket } from \"mysql2\";\nimport mysqlPool from \"../../core/db/db\";\nimport { UserBody } from \"../../core/types/types\";\nimport { constants } from \"../../core/utils/constants\";\n\ntype QueryParams = Array<string | number | boolean | Date | null>;\n\ntype AuthUserRow = RowDataPacket & {\n  id: number;\n  nombre: string;\n  apellidos: string;\n  email: string;\n  password: string;\n  rol_usuario: string;\n};\n\nconst queryAsync = <T = RowDataPacket[]>(\n  sql: string,\n  params: QueryParams = []\n): Promise<T> => {\n  return new Promise((resolve, reject) => {\n    mysqlPool.query(sql, params, (err, result) => {\n      if (err) return reject(err);\n      resolve(result as T);\n    });\n  });\n};\n\nexport const findUserByEmail = async (email: string): Promise<AuthUserRow | null> => {\n  const sql = constants.SQL_QUERIES.AUTH.CHECK_USER_BY_EMAIL;\n  const result = await queryAsync<AuthUserRow[]>(sql, [email]);\n  return result[0] ?? null;\n};\n\nexport const insertUser = async (user: UserBody, hashedPassword: string) => {\n  const sql = constants.SQL_QUERIES.AUTH.INSERT_USER;\n  return queryAsync<ResultSetHeader>(sql, [\n    user.nombre,\n    user.apellidos,\n    user.email,\n    hashedPassword,\n    user.rol_usuario,\n  ]);\n};\n\nexport const validateUserByEmailAndRole = async (\n  email: string,\n  rolUsuario: string\n): Promise<AuthUserRow | null> => {\n  const sql = constants.SQL_QUERIES.AUTH.TOKEN_VALIDATION;\n  const result = await queryAsync<AuthUserRow[]>(sql, [email, rolUsuario]);\n  return result[0] ?? null;\n};\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import { ResultSetHeader, RowDataPacket } from \"mysql2\";\nimport mysqlPool from \"../../core/db/db\";\nimport { UserBody } from \"../../core/types/types\";\nimport { constants } from \"../../core/utils/constants\";\n\ntype QueryParams = Array<string | number | boolean | Date | null>;\n\ntype AuthUserRow = RowDataPacket & {\n  id: number;\n  nombre: string;\n  apellidos: string;\n  email: string;\n  password: string;\n  rol_usuario: string;\n};\n\nconst queryAsync = <T = RowDataPacket[]>(\n  sql: string,\n  params: QueryParams = []\n): Promise<T> => {\n  return new Promise((resolve, reject) => {\n    mysqlPool.query(sql, params, (err, result) => {\n      if (err) return reject(err);\n      resolve(result as T);\n    });\n  });\n};\n\nexport const findUserByEmail = async (email: string): Promise<AuthUserRow | null> => {\n  const sql = constants.SQL_QUERIES.AUTH.CHECK_USER_BY_EMAIL;\n  const result = await queryAsync<AuthUserRow[]>(sql, [email]);\n  return result[0] ?? null;\n};\n\nexport const insertUser = async (user: UserBody, hashedPassword: string) => {\n  const sql = constants.SQL_QUERIES.AUTH.INSERT_USER;\n  return queryAsync<ResultSetHeader>(sql, [\n    user.nombre,\n    user.apellidos,\n    user.email,\n    hashedPassword,\n    user.rol_usuario,\n  ]);\n};\n\nexport const validateUserByEmailAndRole = async (\n  email: string,\n  rolUsuario: string\n): Promise<AuthUserRow | null> => {\n  const sql = constants.SQL_QUERIES.AUTH.TOKEN_VALIDATION;\n  const result = await queryAsync<AuthUserRow[]>(sql, [email, rolUsuario]);\n  return result[0] ?? null;\n};\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
