    {
      "id": "oBdsjutI3QLKAPVD284pn",
      "type": "text",
      "x": -319.98540965586653,
      "y": -10533.725210603421,
      "width": 913,
      "height": 1125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
