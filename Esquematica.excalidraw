    {
      "id": "Zjlr8sEt9XfmDOOOjR0iC",
      "type": "text",
      "x": 1542.6407963929291,
      "y": -8757.312413211625,
      "width": 1089,
      "height": 1350,
      "angle": 0,
      "strokeColor": "#e03131",
